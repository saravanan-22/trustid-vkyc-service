# Copy to .env and fill in. Generate each secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Comma-separated API keys accepted in the X-API-KEY header (min 24 chars each).
TRUSTID_API_KEYS=

# HMAC key for signing audit dossiers. Keep private (min 32 chars).
AUDIT_SIGNING_SECRET=

# HMAC key for signing webhooks. Shared with integrators; must differ from the audit key.
WEBHOOK_SIGNING_SECRET=

# Optional
# ENVIRONMENT=development
# REDIS_URL=redis://localhost:6379/0     # required for more than one worker
# BACKEND_CORS_ORIGINS=https://app.example.com
# OCR_ENGINE=auto                         # auto | tesseract | none
# FACE_MATCH_THRESHOLD=0.363
# CAMERA_FRAMES_MIRRORED=false
# WEBHOOK_ALLOW_HTTP=false
# WEBHOOK_ALLOW_PRIVATE_NETWORKS=false    # local testing only
