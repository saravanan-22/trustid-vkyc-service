{
  "info": {
    "_postman_id": "a93e5d87-3214-4eb5-a202-trustid-vkyc",
    "name": "TrustID Video KYC API",
    "description": "TrustID Video KYC API (reference implementation). Sessions, document checks, 1:1 face match, active/passive liveness and signed audit dossiers.\n\nSet `apiKey` in the environment to one of the server's TRUSTID_API_KEYS values. The full-verification request sends a single still photo, so it is expected to be REJECTED for ACTIVE_LIVENESS_FAILED; a real run needs the ordered webcam frames captured by the demo portal.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "sessionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "verificationId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "System & Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Reports whether the face models, server OCR and session store are actually available (503 when degraded)."
          }
        },
        {
          "name": "OpenAPI Specification",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/openapi.json",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "openapi.json"]
            }
          }
        }
      ]
    },
    {
      "name": "1. Sessions & Challenges",
      "item": [
        {
          "name": "Create VKYC Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.session_id) {",
                  "    pm.collectionVariables.set('sessionId', res.session_id);",
                  "    console.log('Saved sessionId:', res.session_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"usr_fintech_9812\",\n  \"document_type\": \"AADHAAR\",\n  \"callback_url\": \"https://webhook.site/sample-receiver\",\n  \"metadata\": {\n    \"account_tier\": \"gold\",\n    \"branch\": \"mumbai_main\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/sessions/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sessions", ""]
            },
            "description": "Creates a single-use session with randomized head-turn / blink / smile challenges. Expires after SESSION_EXPIRY_SECONDS and is visible only to the API key that created it."
          }
        },
        {
          "name": "Get Session State",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/sessions/{{sessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sessions", "{{sessionId}}"]
            },
            "description": "Retrieves the status and assigned challenges of an active session."
          }
        }
      ]
    },
    {
      "name": "2. Biometrics & Liveness",
      "item": [
        {
          "name": "Check Passive Liveness",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "frame",
                  "type": "file",
                  "src": "sample_assets/sample_live_face.jpg"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/liveness/passive",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "liveness", "passive"]
            },
            "description": "Heuristic single-frame check (blur, glare, skin chroma) on the detected face. Not a certified presentation-attack-detection model."
          }
        },
        {
          "name": "Check Active Liveness Sequence",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "session_id",
                  "value": "{{sessionId}}",
                  "type": "text"
                },
                {
                  "key": "frames",
                  "type": "file",
                  "src": "sample_assets/sample_live_face.jpg"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/liveness/active",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "liveness", "active"]
            },
            "description": "Dry-run of the session's challenges against ordered frames (needs several frames showing the movement). Does not consume the session."
          }
        },
        {
          "name": "1-to-1 Face Match",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "id_card_image",
                  "type": "file",
                  "src": "sample_assets/sample_id_card.jpg"
                },
                {
                  "key": "live_selfie_image",
                  "type": "file",
                  "src": "sample_assets/sample_live_face.jpg"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/face/match",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "face", "match"]
            },
            "description": "1:1 face verification using SFace embeddings (cosine similarity vs. threshold)."
          }
        }
      ]
    },
    {
      "name": "3. Document Verification",
      "item": [
        {
          "name": "Verify ID Document & OCR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "document_image",
                  "type": "file",
                  "src": "sample_assets/sample_id_card.jpg"
                },
                {
                  "key": "extracted_text",
                  "value": "SPECIMEN - GOVERNMENT OF INDIA - AADHAAR\nName: Demo Applicant\nDOB: 15/08/1994\nGender: FEMALE\n9841 2341 5679",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/document/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "document", "verify"]
            },
            "description": "Checks image quality and face presence, extracts fields (server OCR if installed, else the supplied text) and validates Aadhaar/PAN/MRZ checksums."
          }
        }
      ]
    },
    {
      "name": "4. Full VKYC Pipeline",
      "item": [
        {
          "name": "Execute Full VKYC Verification",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.verification_id) {",
                  "    pm.collectionVariables.set('verificationId', res.verification_id);",
                  "    console.log('Saved verificationId:', res.verification_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "session_id",
                  "value": "{{sessionId}}",
                  "type": "text"
                },
                {
                  "key": "id_document",
                  "type": "file",
                  "src": "sample_assets/sample_id_card.jpg"
                },
                {
                  "key": "live_frames",
                  "type": "file",
                  "src": "sample_assets/sample_live_face.jpg"
                },
                {
                  "key": "extracted_ocr_text",
                  "value": "SPECIMEN - GOVERNMENT OF INDIA - AADHAAR\nName: Demo Applicant\nDOB: 15/08/1994\nGender: FEMALE\n9841 2341 5679",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/verify/full",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "verify", "full"]
            },
            "description": "Runs the full pipeline and writes a signed, hash-chained audit dossier. With the single sample photo this returns REJECTED (ACTIVE_LIVENESS_FAILED) by design; send ordered challenge frames for a real run. Each session can be verified once."
          }
        }
      ]
    },
    {
      "name": "5. Audit & Compliance",
      "item": [
        {
          "name": "Get Cryptographic Audit Dossier",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/audit/{{verificationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "audit", "{{verificationId}}"]
            },
            "description": "Returns the dossier after recomputing its hash from the stored content and checking its HMAC signature (409 if modified)."
          }
        }
      ]
    }
  ]
}
