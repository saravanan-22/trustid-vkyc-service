meta {
  name: Create VKYC Session
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/sessions/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-API-KEY: {{apiKey}}
}

body:json {
  {
    "user_id": "usr_fintech_9812",
    "document_type": "AADHAAR",
    "callback_url": "https://webhook.site/sample-receiver",
    "metadata": {
      "account_tier": "gold",
      "branch": "mumbai_main"
    }
  }
}

script:post-response {
  if (res.body && res.body.session_id) {
    bru.setEnvVar("sessionId", res.body.session_id);
  }
}
