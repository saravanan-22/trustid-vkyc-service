meta {
  name: Execute Full VKYC
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/verify/full
  body: multipartForm
  auth: none
}

headers {
  X-API-KEY: {{apiKey}}
}

body:multipart-form {
  session_id: {{sessionId}}
  id_document: @file(samples/sample_id_card.jpg)
  live_frames: @file(samples/sample_live_face.jpg)
  extracted_ocr_text: SPECIMEN - GOVERNMENT OF INDIA - AADHAAR\nName: Demo Applicant\nDOB: 15/08/1994\nGender: FEMALE\n9841 2341 5679
}

script:post-response {
  if (res.body && res.body.verification_id) {
    bru.setEnvVar("verificationId", res.body.verification_id);
  }
}
