meta {
  name: Verify ID Document
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/document/verify
  body: multipartForm
  auth: none
}

headers {
  X-API-KEY: {{apiKey}}
}

body:multipart-form {
  document_image: @file(samples/sample_id_card.jpg)
  extracted_text: SPECIMEN - GOVERNMENT OF INDIA - AADHAAR\nName: Demo Applicant\nDOB: 15/08/1994\nGender: FEMALE\n9841 2341 5679
}
